+    private fun freshCachedOffer(pkg: String): CachedOffer? {
+        val cached = lastOfferCacheByPkg[pkg] ?: return null
+        val age = System.currentTimeMillis() - cached.at
+        if (age !in 0..AUTO_OFFER_CACHE_MAX_MS) {
+            lastOfferCacheByPkg.remove(pkg)
+            return null
+        }
