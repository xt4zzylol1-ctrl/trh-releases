+        lastWazeAutoScanAt = now
+        if (now - lastWazeAutoClickAt < WAZE_AUTO_CLICK_COOLDOWN_MS) return
+
+        val roots = ArrayList<AccessibilityNodeInfo>()
+        fun addRoot(node: AccessibilityNodeInfo?) {
+            if (node?.packageName?.toString() == WAZE_PACKAGE && !roots.contains(node)) roots.add(node)
+        }
+
+        try { addRoot(event.source) } catch (_: Exception) {}
+        try { addRoot(rootInActiveWindow) } catch (_: Exception) {}
+        try {
+            windows.forEach { addRoot(it.root) }
+        } catch (_: Exception) {
+        }
+
+        for (root in roots) {
+            val target = findWazeClickTarget(root) ?: continue
+            if (target.node.performAction(AccessibilityNodeInfo.ACTION_CLICK)) {
+                lastWazeAutoClickAt = now
+                StatsStore.addDiag(
+                    this,
+                    "Waze auto-apasare",
+                    target.text.take(600),
+                    "apasat automat: ${target.marker}"
+                )
+                return
+            }
+        }
+    }
+
+    private fun findWazeClickTarget(root: AccessibilityNodeInfo): WazeClickTarget? {
+        val queue = ArrayDeque<AccessibilityNodeInfo>()
+        queue.add(root)
+        while (queue.isNotEmpty()) {
+            val node = queue.removeFirst()
+            val ownText = wazeNodeText(node, deep = false)
+            val deep = node.isClickable || node.className?.toString()?.contains("Button", ignoreCase = true) == true
+            val text = if (deep) wazeNodeText(node, deep = true) else ownText
+            val marker = wazeMarker(text)
+            if (marker != null) {
+                val clickable = clickableWazeNode(node)
+                if (clickable != null) return WazeClickTarget(clickable, marker, text)
+            }
+            for (i in 0 until node.childCount) {
+                node.getChild(i)?.let { queue.add(it) }
+            }
+        }
+        return null
+    }
+
+    private fun wazeNodeText(node: AccessibilityNodeInfo, deep: Boolean): String {
+        val out = ArrayList<String>(4)
+        fun add(value: CharSequence?) {
+            val text = value?.toString()?.trim()
+            if (!text.isNullOrBlank()) out.add(text)
+        }
+        fun collect(n: AccessibilityNodeInfo, depth: Int) {
+            if (out.size >= 24 || depth > 3) return
+            add(n.text)
+            add(n.contentDescription)
+            if (!deep) return
+            for (i in 0 until n.childCount) {
+                n.getChild(i)?.let { collect(it, depth + 1) }
+                if (out.size >= 24) break
+            }
+        }
+        collect(node, 0)
+        return out.distinct().joinToString(" ")
+    }
+
+    private fun wazeMarker(text: String): String? {
+        val normalized = markerText(text)
+        return when {
+            WAZE_CONDU_ACUM_REGEX.containsMatchIn(normalized) -> "Condu acum"
+            WAZE_REIA_REGEX.containsMatchIn(normalized) -> "Reia"
+            else -> null
+        }
+    }
+
+    private fun clickableWazeNode(node: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+        var current: AccessibilityNodeInfo? = node
+        repeat(7) {
+            val n = current ?: return null
+            if (n.isVisibleToUser && n.isEnabled && n.isClickable) return n
+            current = n.parent
+        }
+        return null
+    }
