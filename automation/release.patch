+                    textSize = 15f
+                    setTextColor(white)
+                    setTypeface(typeface, Typeface.BOLD)
+                    setPadding(0, dp(14), 0, dp(4))
+                }
+                card.addView(sectionTitle)
+                for (item in section.items) {
+                    val bullet = TextView(this).apply {
+                        text = "•  $item"
+                        textSize = 13f
+                        setTextColor(Color.parseColor("#C7D2E0"))
+                        setLineSpacing(0f, 1.2f)
+                        setPadding(dp(4), dp(4), 0, dp(4))
+                    }
+                    card.addView(bullet)
+                }
+            }
+
+            val lp = LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT)
+            lp.bottomMargin = dp(12)
+            list.addView(card, lp)
+        }
+
+        scroll.addView(list, LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT))
+        root.addView(scroll, LinearLayout.LayoutParams(MATCH_PARENT, 0, 1f))
+        setContentView(root)
+    }
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+}
diff --git a/app/src/main/java/com/example/boltassist/DiagnosticReport.kt b/app/src/main/java/com/example/boltassist/DiagnosticReport.kt
new file mode 100644
index 0000000..986c4ff
--- /dev/null
+++ b/app/src/main/java/com/example/boltassist/DiagnosticReport.kt
@@ -0,0 +1,176 @@
+package com.example.boltassist
+
+import android.app.NotificationManager
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.PowerManager
+import android.provider.Settings
+import android.text.format.DateFormat
+
+// Construiește raportul de diagnostic ca text — folosit atât de ecranul Diagnostic
+// (export ca fișier), cât și de trimiterea automată către serverul de licențe.
+object DiagnosticReport {
+    // ~200 KB text; ecranul primește propriul buget ca să nu fie eliminat de jurnal
+    const val MAX_REPORT_CHARS = 200_000
+    const val SCREEN_TEXT_BUDGET = 25_000
+
+    fun build(context: Context): String {
+        ConfigManager.loadFromPrefs(context)
+        val prefs = context.getSharedPreferences("boltassist", Context.MODE_PRIVATE)
+        val svc = BoltReaderService.instance
+        fun yn(b: Boolean) = if (b) "DA" else "NU"
+        val sb = StringBuilder()
+
+        // 1. Antet
+        sb.appendLine("=== RAPORT DIAGNOSTIC TazRideHelper ===")
+        sb.appendLine("Versiune: ${BuildConfig.VERSION_NAME} (code ${BuildConfig.VERSION_CODE})")
+        sb.appendLine("Exportat: ${DateFormat.format("dd.MM.yyyy HH:mm:ss", System.currentTimeMillis())}")
+        sb.appendLine("Telefon: ${Build.MANUFACTURER} ${Build.MODEL}")
+        sb.appendLine("Android: ${Build.VERSION.RELEASE} (SDK ${Build.VERSION.SDK_INT})")
+        sb.appendLine("Skin: ${detectSkin()}")
+        val xiaomiLike = isXiaomiLikeDevice()
+        val motorolaLike = isMotorolaLikeDevice()
+        sb.appendLine("Xiaomi/Redmi/POCO detectat: ${yn(xiaomiLike)}")
+        sb.appendLine("Motorola/Lenovo detectat: ${yn(motorolaLike)}")
+        sb.appendLine("Tip overlay TRH: ${if (xiaomiLike) "TYPE_ACCESSIBILITY_OVERLAY" else "TYPE_APPLICATION_OVERLAY"}")
+        sb.appendLine("Fallback Uber relaxat: ${yn(xiaomiLike || motorolaLike)}")
+
+        // 2. Permisiuni
+        sb.appendLine()
+        sb.appendLine("--- PERMISIUNI ---")
+        sb.appendLine("Accesibilitate: ${yn(svc != null)}")
+        sb.appendLine("Overlay: ${yn(Settings.canDrawOverlays(context))}")
+        sb.appendLine("Locație: ${yn(context.checkSelfPermission(android.Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED)}")
+        sb.appendLine("Exceptat de la battery optimization: ${yn((context.getSystemService(Context.POWER_SERVICE) as PowerManager).isIgnoringBatteryOptimizations(context.packageName))}")
+        sb.appendLine("Notificări permise: ${yn((context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager).areNotificationsEnabled())}")
+
+        // 3. Stare serviciu
+        sb.appendLine()
+        sb.appendLine("--- SERVICIU ---")
+        sb.appendLine("Serviciu accesibilitate rulează: ${yn(svc != null)}")
+        val lastEv = svc?.diagLastEventAt() ?: 0L
+        sb.appendLine("Ultimul eveniment procesat: " + when {
+            svc == null -> "(serviciul nu rulează)"
+            lastEv == 0L -> "(niciun eveniment de la pornire)"
+            else -> "acum ${(System.currentTimeMillis() - lastEv) / 1000} s (${DateFormat.format("dd.MM HH:mm:ss", lastEv)})"
+        })
+        sb.appendLine("Pachete monitorizate: ${BoltReaderService.BOLT_PACKAGE} (Bolt), ${BoltReaderService.UBER_PACKAGE} (Uber), ${BoltReaderService.WAZE_PACKAGE} (Waze)")
+        sb.appendLine("Suport Uber: activ permanent (fără comutator; pachet config: ${ConfigManager.current.uber.packageName})")
+        val cfg = ConfigManager.current
+        val ocrSupported = Build.VERSION.SDK_INT >= Build.VERSION_CODES.R
+        val ocrKey = LicenseManager.getSavedKey(context)?.trim()?.uppercase(java.util.Locale.US)
+        val ocrForcedByConfig = cfg.uberOcrAll || (ocrKey != null && cfg.uberOcrKeys.contains(ocrKey))
+        val ocrOn = ocrSupported
+        sb.appendLine("Uber OCR: ${yn(ocrOn)} (suportat dispozitiv: ${yn(ocrSupported)}; auto pentru Uber fara text; config all=${cfg.uberOcrAll}, chei=${cfg.uberOcrKeys.size}, fortat=${yn(ocrForcedByConfig)})")
+
+        // 3b. Update in-app
+        val update = ConfigManager.current.update
+        val lastUpdateCheck = prefs.getLong("lastUpdateCheckMs", 0L)
+        val installedCode = installedVersionCode(context)
+        sb.appendLine()
+        sb.appendLine("--- UPDATE IN-APP ---")
+        sb.appendLine("Cod instalat efectiv: $installedCode")
+        sb.appendLine("BuildConfig code/name: ${BuildConfig.VERSION_CODE} / ${BuildConfig.VERSION_NAME}")
+        sb.appendLine("Ultima verificare config: " + if (lastUpdateCheck > 0L) {
+            "${DateFormat.format("dd.MM.yyyy HH:mm:ss", lastUpdateCheck)} (acum ${(System.currentTimeMillis() - lastUpdateCheck) / 60000} min)"
+        } else {
+            "(niciodata)"
+        })
+        if (update == null) {
+            sb.appendLine("Update config: lipsa")
+            sb.appendLine("Card update ar trebui afisat: NU")
+        } else {
+            sb.appendLine("Latest din config: ${update.latestVersionName} (code ${update.latestVersionCode})")
+            sb.appendLine("APK URL: ${update.apkUrl}")
+            sb.appendLine("Changelog: ${update.changelog}")
+            sb.appendLine("Card update ar trebui afisat: ${yn(update.latestVersionCode.toLong() > installedCode)}")
+        }
+
+        // 4. Setări curente
+        sb.appendLine()
+        sb.appendLine("--- SETĂRI ---")
+        val defaultTablet = context.resources.configuration.smallestScreenWidthDp >= 600
+        sb.appendLine("Hartă mică: ${yn(prefs.getBoolean("mapSmallOn", true))}")
+        sb.appendLine("Mod tabletă: ${yn(prefs.getBoolean("tabletMode", defaultTablet))}")
+        sb.appendLine("Privacy automat la accept: ${yn(prefs.getBoolean("privacyAutoOnAccept", false))}")
+        sb.appendLine("Privacy mode activ acum: ${yn(prefs.getBoolean("privacyMode", false))}")
+        sb.appendLine("Waze auto Condu acum/Reia: ${yn(prefs.getBoolean("wazeAutoDriveOn", true))}")
+        sb.appendLine("Salvare statistici: ${yn(prefs.getBoolean("statsOn", true))}")
+        sb.appendLine("Curse individuale (statistici detaliate): ${yn(prefs.getBoolean("statsDetailOn", true))}")
+        sb.appendLine("Recomandări: ${yn(prefs.getBoolean("recommendOn", true))}")
+        sb.appendLine("Fără penalizare: ${yn(prefs.getBoolean("noPenaltyOn", true))}")
+        sb.appendLine("Puls: ${yn(prefs.getBoolean("pulseOn", false))}")
+        sb.appendLine("Vibrație: ${yn(prefs.getBoolean("vibrateOn", true))}")
+        sb.appendLine("Auto-detectare acceptare manuala: ${yn(prefs.getBoolean("manualAcceptAutoDetectOn", true))}")
+        sb.appendLine("Urmărire km GPS: ${yn(prefs.getBoolean("gpsTrackEnabled", false))}")
+        sb.appendLine("Consum: ${prefs.getFloat("consum", 7.0f)} l/100km")
+        sb.appendLine("Preț combustibil: ${prefs.getFloat("pret", 8.0f)} lei/l")
+        sb.appendLine("Prag acceptare: ${prefs.getFloat("accept", 3.0f)} lei/km")
+        sb.appendLine("Prag refuz: ${prefs.getFloat("refuse", 1.5f)} lei/km")
+
+        // 5. Jurnal (cele mai noi primele; buget lăsat și pentru secțiunea 6)
+        sb.appendLine()
+        sb.appendLine("--- JURNAL EVENIMENTE (max 50, cele mai noi primele) ---")
+        val arr = StatsStore.getDiag(context)
+        if (arr.length() == 0) sb.appendLine("(gol)")
+        for (i in 0 until minOf(arr.length(), 50)) {
+            val o = arr.getJSONObject(i)
+            val line = "[${DateFormat.format("dd.MM HH:mm:ss", o.optLong("t"))}] ${o.optString("event")} → ${o.optString("result")}/n    ${o.optString("text").replace('/n', ' ')}"
+            if (sb.length + line.length > MAX_REPORT_CHARS - SCREEN_TEXT_BUDGET) {
+                sb.appendLine("... (jurnal tăiat — limită de dimensiune raport)")
+                break
+            }
+            sb.appendLine(line)
+        }
+
+        // 6. Ultimul text de pe ecran
+        sb.appendLine()
+        sb.appendLine("--- ULTIMUL TEXT CITIT DE PE ECRAN ---")
+        val screen = svc?.diagLastScreen()?.ifBlank { "(nimic încă)" } ?: "(serviciul nu rulează)"
+        sb.appendLine(screen.take(SCREEN_TEXT_BUDGET))
+
+        sb.appendLine()
+        sb.appendLine("=== SFÂRȘIT RAPORT ===")
+        return sb.toString()
+    }
+
+    private fun detectSkin(): String = try {
+        val get = Class.forName("android.os.SystemProperties").getMethod("get", String::class.java)
+        listOf(
+            "ro.mi.os.version.name" to "HyperOS",
+            "ro.miui.ui.version.name" to "MIUI",
+            "ro.build.version.oneui" to "One UI",
+            "ro.build.version.opporom" to "ColorOS",
+            "ro.vivo.os.version" to "Funtouch/OriginOS",
+            "ro.build.version.emui" to "EMUI"
+        ).firstNotNullOfOrNull { (key, name) ->
+            (get.invoke(null, key) as? String)?.takeIf { it.isNotBlank() }?.let { "$name $it" }
+        } ?: "necunoscut/stock"
+    } catch (e: Exception) { "necunoscut" }
+
+    private fun isXiaomiLikeDevice(): Boolean {
+        val maker = "${Build.MANUFACTURER} ${Build.BRAND}".lowercase(java.util.Locale.ROOT)
+        return maker.contains("xiaomi") || maker.contains("redmi") || maker.contains("poco")
+    }
+
+    private fun isMotorolaLikeDevice(): Boolean {
+        val maker = "${Build.MANUFACTURER} ${Build.BRAND}".lowercase(java.util.Locale.ROOT)
+        return maker.contains("motorola") || maker.contains("moto") || maker.contains("lenovo")
+    }
+
+    @Suppress("DEPRECATION")
+    private fun installedVersionCode(context: Context): Long {
+        return try {
+            val info = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                context.packageManager.getPackageInfo(context.packageName, PackageManager.PackageInfoFlags.of(0))
+            } else {
+                context.packageManager.getPackageInfo(context.packageName, 0)
+            }
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) info.longVersionCode
+            else info.versionCode.toLong()
+        } catch (_: Exception) {
+            BuildConfig.VERSION_CODE.toLong()
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/boltassist/UberOcr.kt b/app/src/main/java/com/example/boltassist/UberOcr.kt
new file mode 100644
index 0000000..5ef4e55
--- /dev/null
+++ b/app/src/main/java/com/example/boltassist/UberOcr.kt
@@ -0,0 +1,169 @@
+package com.example.boltassist
+
+import android.accessibilityservice.AccessibilityService
+import android.graphics.Bitmap
+import android.graphics.ColorSpace
+import android.os.Build
+import android.os.SystemClock
+import android.view.Display
+import androidx.annotation.RequiresApi
+import com.google.mlkit.vision.common.InputImage
+import com.google.mlkit.vision.text.TextRecognition
+import com.google.mlkit.vision.text.latin.TextRecognizerOptions
+
+// OCR local pentru ofertele Uber care nu sunt expuse prin accessibility (Xiaomi/HyperOS etc.).
+// Rulează doar când Uber trimite evenimente, dar nu expune text prin Accessibility. Captura folosește
+// API-ul oficial AccessibilityService.takeScreenshot (Android 11+), fără permisiuni noi.
+// Recunoașterea de text e ML Kit on-device — nimic nu părăsește telefonul.
+object UberOcr {
+
+    // sistemul limitează capturi la ~1/secundă; ținem un prag propriu mai relaxat
+    private const val MIN_INTERVAL_MS = 2500L
+
+    private val recognizer by lazy {
+        TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS)
+    }
+
+    private var lastRunAt = 0L
+    @Volatile private var inFlight = false
+    @Volatile private var warmedUp = false
+
+    fun isSupported(): Boolean = Build.VERSION.SDK_INT >= Build.VERSION_CODES.R
+
+    // pre-descarcă modelul din Play Services (o singură dată), ca prima ofertă reală
+    // să nu eșueze cu „model indisponibil". Rulează pe o imagine goală, ignoră rezultatul.
+    fun warmUp() {
+        if (warmedUp) return
+        warmedUp = true
+        try {
+            val bmp = Bitmap.createBitmap(32, 32, Bitmap.Config.ARGB_8888)
+            recognizer.process(InputImage.fromBitmap(bmp, 0))
+                .addOnCompleteListener { bmp.recycle() }
+        } catch (_: Exception) {
+        }
+    }
+
+    // capture(): face o captură, o trece prin OCR și livrează liniile de text.
+    // onFail primește un motiv scurt (pentru diagnostic). Callback-urile vin de pe threaduri de sistem.
+    fun capture(
+        service: AccessibilityService,
+        onLines: (List<String>) -> Unit,
+        onFail: (String) -> Unit
+    ): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) { onFail("android<11"); return false }
+        if (inFlight) return false
+        val now = SystemClock.uptimeMillis()
+        if (now - lastRunAt < MIN_INTERVAL_MS) return false
+        lastRunAt = now
+        inFlight = true
+        takeAndOcr(service, onLines, onFail)
+        return true
+    }
+
+    @RequiresApi(Build.VERSION_CODES.R)
+    private fun takeAndOcr(
+        service: AccessibilityService,
+        onLines: (List<String>) -> Unit,
+        onFail: (String) -> Unit
+    ) {
+        try {
+            service.takeScreenshot(
+                Display.DEFAULT_DISPLAY,
+                service.mainExecutor,
+                object : AccessibilityService.TakeScreenshotCallback {
+                    override fun onSuccess(result: AccessibilityService.ScreenshotResult) {
+                        var software: Bitmap? = null
+                        try {
+                            val buffer = result.hardwareBuffer ?: run {
+                                inFlight = false
+                                onFail("captura fara hardwareBuffer")
+                                return
+                            }
+                            val colorSpace = result.colorSpace ?: ColorSpace.get(ColorSpace.Named.SRGB)
+                            val hw = try {
+                                Bitmap.wrapHardwareBuffer(buffer, colorSpace)
+                            } finally {
+                                buffer.close()
+                            }
+                            if (hw == null) { inFlight = false; onFail("bitmap null"); return }
+                            // ML Kit are nevoie de un bitmap software (nu hardware)
+                            software = hw.copy(Bitmap.Config.ARGB_8888, false)
+                            hw.recycle()
+                            val sw = software
+                            if (sw == null) { inFlight = false; onFail("copie bitmap esuata"); return }
+                            ocr(sw, onLines, onFail)
+                        } catch (e: Exception) {
+                            software?.recycle()
+                            inFlight = false
+                            onFail(shortError("captura", e))
+                        }
+                    }
+
+                    override fun onFailure(errorCode: Int) {
+                        inFlight = false
+                        onFail(screenshotError(errorCode))
+                    }
+                }
+            )
+        } catch (e: Exception) {
+            inFlight = false
+            onFail(shortError("takeScreenshot", e))
+        }
+    }
+
+    private fun ocr(
+        bmp: Bitmap,
+        onLines: (List<String>) -> Unit,
+        onFail: (String) -> Unit
+    ) {
+        val image = InputImage.fromBitmap(bmp, 0)
+        recognizer.process(image)
+            .addOnSuccessListener { text ->
+                val lines = ArrayList<String>()
+                for (block in text.textBlocks) {
+                    for (line in block.lines) {
+                        val t = line.text.trim()
+                        if (t.isNotEmpty()) lines.add(t)
+                    }
+                }
+                bmp.recycle()
+                inFlight = false
+                onLines(lines)
+            }
+            .addOnFailureListener { e ->
+                bmp.recycle()
+                inFlight = false
+                onFail(shortError("ocr", e))
+            }
+    }
+
+    private fun shortError(prefix: String, e: Exception): String {
+        val msg = e.message?.replace('/n', ' ')?.take(160).orEmpty()
+        return if (msg.isBlank()) "$prefix: ${e.javaClass.simpleName}"
+        else "$prefix: ${e.javaClass.simpleName} - $msg"
+    }
+
+    @RequiresApi(Build.VERSION_CODES.R)
+    private fun screenshotError(errorCode: Int): String {
+        if (Build.VERSION.SDK_INT >= 34) {
+            when (errorCode) {
+                AccessibilityService.ERROR_TAKE_SCREENSHOT_INVALID_WINDOW ->
+                    return "captura esuata: fereastra invalida (cod=$errorCode)"
+                AccessibilityService.ERROR_TAKE_SCREENSHOT_SECURE_WINDOW ->
+                    return "captura esuata: Uber blocheaza screenshot-ul / ecran securizat (cod=$errorCode)"
+            }
+        }
+        return when (errorCode) {
+            AccessibilityService.ERROR_TAKE_SCREENSHOT_INTERNAL_ERROR ->
+                "captura esuata: eroare interna Android (cod=$errorCode)"
+            AccessibilityService.ERROR_TAKE_SCREENSHOT_NO_ACCESSIBILITY_ACCESS ->
+                "captura esuata: lipseste accesul de screenshot; reactiveaza serviciul din Accesibilitate dupa update (cod=$errorCode)"
+            AccessibilityService.ERROR_TAKE_SCREENSHOT_INTERVAL_TIME_SHORT ->
+                "captura amanata: Android limiteaza capturile prea dese (cod=$errorCode)"
+            AccessibilityService.ERROR_TAKE_SCREENSHOT_INVALID_DISPLAY ->
+                "captura esuata: display invalid (cod=$errorCode)"
+            else ->
+                "captura esuata: cod necunoscut $errorCode"
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/boltassist/UpdateManager.kt b/app/src/main/java/com/example/boltassist/UpdateManager.kt
new file mode 100644
index 0000000..85583ec
--- /dev/null
+++ b/app/src/main/java/com/example/boltassist/UpdateManager.kt
@@ -0,0 +1,117 @@
+package com.example.boltassist
+
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import androidx.core.content.FileProvider
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+
+object UpdateManager {
+
+    private const val MAX_REDIRECTS = 5
+
+    fun apkFile(context: Context): File =
+        File(File(context.cacheDir, "updates").apply { mkdirs() }, "tazsridehelper-update.apk")
+
+    // Rulează pe thread separat; callback-urile vin de pe acel thread
+    fun download(
+        context: Context,
+        info: UpdateInfo,
+        onProgress: (Int) -> Unit, // 0-100, sau -1 dacă dimensiunea totală e necunoscută
+        onError: (String) -> Unit,
+        onReady: (File) -> Unit
+    ) {
+        Thread {
+            val file = apkFile(context)
+            var conn: HttpURLConnection? = null
+            try {
+                file.delete()
+                conn = openWithRedirects(info.apkUrl)
+                if (conn.responseCode != 200) {
+                    onError("serverul a răspuns cu codul ${conn.responseCode}")
+                    return@Thread
+                }
+                val total = conn.contentLength
+                conn.inputStream.use { input ->
+                    file.outputStream().use { out ->
+                        val buf = ByteArray(64 * 1024)
+                        var read = 0L
+                        while (true) {
+                            val n = input.read(buf)
+                            if (n < 0) break
+                            out.write(buf, 0, n)
+                            read += n
+                            onProgress(if (total > 0) ((read * 100) / total).toInt() else -1)
+                        }
+                    }
+                }
+                when {
+                    file.length() <= 0L ->
+                        onError("fișierul descărcat e gol")
+                    total > 0 && file.length() != total.toLong() ->
+                        onError("descărcare incompletă (${file.length()}/$total octeți)")
+                    info.apkSha256 != null && !sha256(file).equals(info.apkSha256.trim(), ignoreCase = true) ->
+                        onError("verificarea integrității (SHA-256) a eșuat")
+                    else -> onReady(file)
+                }
+            } catch (e: Exception) {
+                onError(e.message ?: "eroare de rețea")
+            } finally {
+                conn?.disconnect()
+            }
+        }.start()
+    }
+
+    fun canInstall(context: Context): Boolean =
+        Build.VERSION.SDK_INT < Build.VERSION_CODES.O ||
+            context.packageManager.canRequestPackageInstalls()
+
+    fun install(context: Context, file: File) {
+        val uri = FileProvider.getUriForFile(
+            context, "${BuildConfig.APPLICATION_ID}.fileprovider", file
+        )
+        context.startActivity(
+            Intent(Intent.ACTION_VIEW).apply {
+                setDataAndType(uri, "application/vnd.android.package-archive")
+                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            }
+        )
+    }
+
+    // GitHub Releases redirecționează către alt host; urmărim manual, cu limită
+    private fun openWithRedirects(startUrl: String): HttpURLConnection {
+        var url = URL(startUrl)
+        repeat(MAX_REDIRECTS) {
+            val conn = url.openConnection() as HttpURLConnection
+            conn.connectTimeout = 15000
+            conn.readTimeout = 30000
+            conn.instanceFollowRedirects = false
+            when (conn.responseCode) {
+                301, 302, 303, 307, 308 -> {
+                    val loc = conn.getHeaderField("Location")
+                        ?: throw IllegalStateException("redirect fără Location")
+                    conn.disconnect()
+                    url = URL(url, loc)
+                }
+                else -> return conn
+            }
+        }
+        throw IllegalStateException("prea multe redirecturi")
+    }
+
+    private fun sha256(file: File): String {
+        val md = MessageDigest.getInstance("SHA-256")
+        file.inputStream().use { input ->
+            val buf = ByteArray(64 * 1024)
+            while (true) {
+                val n = input.read(buf)
+                if (n < 0) break
+                md.update(buf, 0, n)
+            }
+        }
+        return md.digest().joinToString("") { "%02x".format(it) }
+    }
+}
