+    private fun stackVisibleTarget(): Pair<Int, Int> {
+        val dm = resources.displayMetrics
+        val mainSz = dp(64)
+        val satSz = dp(52)
+        val gap = dp(10)
+        val margin = dp(18)
+        val gpsW = dp(52)
+        val minX = margin + gpsW + gap
+        val maxX = dm.widthPixels - margin - mainSz - gap - satSz
+        val minY = margin + satSz + gap
+        val maxY = dm.heightPixels - margin - mainSz - satSz - gap
+        val x = if (maxX >= minX) maxX else ((dm.widthPixels - mainSz) / 2).coerceAtLeast(margin)
+        val desiredY = (dm.heightPixels * 0.58f).toInt()
+        val y = if (maxY >= minY) desiredY.coerceIn(minY, maxY) else ((dm.heightPixels - mainSz) / 2).coerceAtLeast(margin)
+        return x to y
+    }
+
+    private fun isMainStackComfortablyVisible(mp: WindowManager.LayoutParams): Boolean {
+        val dm = resources.displayMetrics
+        val mainSz = dp(64)
+        val satSz = dp(52)
+        val gap = dp(10)
+        val margin = dp(18)
+        val gpsW = dp(52)
+
+        val left = if (stackOpen) minOf(mp.x, mp.x - gap - gpsW) else mp.x
+        val right = if (stackOpen) maxOf(mp.x + mainSz, mp.x + mainSz + gap + satSz) else mp.x + mainSz
+        val top = if (stackOpen) minOf(mp.y, mp.y - gap - satSz) else mp.y
+        val bottom = if (stackOpen) maxOf(mp.y + mainSz, mp.y + mainSz + gap + satSz) else mp.y + mainSz
+        return left >= margin &&
+                right <= dm.widthPixels - margin &&
+                top >= margin &&
+                bottom <= dm.heightPixels - margin
+    }
+
+    private fun bringPrivacyHandleIntoView(reason: String) {
+        showGhost()
+        val ghost = ghostView
+        if (ghost == null) {
+            logFloatingButtonBring(reason, "privacy activ, dar butonul-fantomă nu este disponibil")
+            return
+        }
+        // butonul-fantomă rămâne pe loc; doar îl evidențiem temporar
+        privacyHandleRestore?.let { mainHandler.removeCallbacks(it) }
+        ghost.animate().alpha(0.85f).scaleX(1.08f).scaleY(1.08f).setDuration(160).start()
+        val restore = Runnable {
+            ghostView?.animate()?.alpha(0.35f)?.scaleX(1f)?.scaleY(1f)?.setDuration(220)?.start()
+        }
+        privacyHandleRestore = restore
+        mainHandler.postDelayed(restore, PRIVACY_HANDLE_BOOST_MS)
+        logFloatingButtonBring(reason, "privacy activ; butonul-fantomă evidențiat")
+    }
+
+    private fun bringFloatingButtonIntoView(reason: String) {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            mainHandler.post { bringFloatingButtonIntoView(reason) }
+            return
+        }
+
+        val now = SystemClock.uptimeMillis()
+        if (now - lastFloatingButtonBringAt < FLOATING_BUTTON_BRING_COOLDOWN_MS) return
+        lastFloatingButtonBringAt = now
+
+        if (!Settings.canDrawOverlays(this)) {
+            logFloatingButtonBring(reason, "ignorat: permisiunea overlay lipseste")
+            return
+        }
+
+        if (privacyMode) {
+            bringPrivacyHandleIntoView(reason)
+            return
+        }
+
+        showButtonStack()
+        val mp = mainParams
+        if (mp == null) {
+            logFloatingButtonBring(reason, "ignorat: stack-ul nu a putut fi afisat")
+            return
+        }
+
+        val openedStack = !stackOpen
+        if (openedStack) {
+            stackOpen = true
+            applyStackVisibility(true)
+        }
+
+        if (!openedStack && isMainStackComfortablyVisible(mp)) {
+            logFloatingButtonBring(reason, "deja vizibil")
+            return
+        }
+
+        val (tx, ty) = stackVisibleTarget()
+        animateMainTo(tx, ty, persist = false)
+        logFloatingButtonBring(
+            reason,
+            "repozitionat temporar x=$tx y=$ty${if (openedStack) "; stack deschis" else ""}"
+        )
+    }
