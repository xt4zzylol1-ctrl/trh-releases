+
+    private fun refreshRemoteConfigForUpdate() {
+        val updatePrefs = getSharedPreferences("boltassist", Context.MODE_PRIVATE)
+        val now = System.currentTimeMillis()
+        val lastUpdateCheck = updatePrefs.getLong("lastUpdateCheckMs", 0L)
+        if (now - lastUpdateCheck < UPDATE_CHECK_INTERVAL_MS) return
+        updatePrefs.edit().putLong("lastUpdateCheckMs", now).apply()
+        ConfigManager.load(this) {
+            runOnUiThread {
+                if (!isDestroyed && mainUiReady) refreshUpdateCard()
+            }
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun installedVersionCode(): Long {
+        return try {
+            val info = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                packageManager.getPackageInfo(packageName, PackageManager.PackageInfoFlags.of(0))
+            } else {
+                packageManager.getPackageInfo(packageName, 0)
+            }
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) info.longVersionCode
+            else info.versionCode.toLong()
+        } catch (_: Exception) {
+            BuildConfig.VERSION_CODE.toLong()
+        }
+    }
+
+    private fun refreshUpdateCard() {
+        val card = findViewById<LinearLayout>(R.id.cardUpdate)
+        val info = ConfigManager.current.update
+        val currentCode = maxOf(BuildConfig.VERSION_CODE.toLong(), installedVersionCode())
+        if (info == null || info.latestVersionCode.toLong() <= currentCode) {
+            card.visibility = View.GONE
+            return
+        }
+        card.visibility = View.VISIBLE
+        findViewById<TextView>(R.id.txtUpdateTitle).text =
+            "Update disponibil — v${info.latestVersionName}"
+        val changelog = findViewById<TextView>(R.id.txtUpdateChangelog)
+        changelog.text = info.changelog
+        changelog.visibility = if (info.changelog.isBlank()) View.GONE else View.VISIBLE
+        val btn = findViewById<Button>(R.id.btnUpdateDownload)
+        btn.applyButtonStyle(R.drawable.bg_button_primary, "#041711")
+        btn.setOnClickListener { if (!updateDownloading) startUpdateDownload(info) }
+    }
+
+    private fun startUpdateDownload(info: UpdateInfo) {
+        updateDownloading = true
+        val btn = findViewById<Button>(R.id.btnUpdateDownload)
+        val progress = findViewById<ProgressBar>(R.id.progressUpdate)
+        val status = findViewById<TextView>(R.id.txtUpdateStatus)
+        btn.isEnabled = false
+        btn.text = "Se descarcă…"
+        progress.visibility = View.VISIBLE
+        progress.isIndeterminate = true
+        status.visibility = View.VISIBLE
+        status.text = "Descărcare în curs…"
+        UpdateManager.download(
+            this, info,
+            onProgress = { pct ->
+                runOnUiThread {
+                    if (isDestroyed) return@runOnUiThread
+                    if (pct >= 0) {
+                        progress.isIndeterminate = false
+                        progress.progress = pct
+                        status.text = "Descărcare: $pct%"
+                    }
+                }
+            },
+            onError = { msg ->
+                runOnUiThread {
+                    if (isDestroyed) return@runOnUiThread
+                    updateDownloading = false
+                    progress.visibility = View.GONE
+                    status.text = "Eroare la descărcare: $msg"
+                    btn.isEnabled = true
+                    btn.text = "Reîncearcă descărcarea"
+                }
+            },
+            onReady = { file ->
+                runOnUiThread {
+                    if (isDestroyed) return@runOnUiThread
+                    updateDownloading = false
+                    progress.visibility = View.GONE
+                    status.text = "Descărcare completă ✅"
+                    btn.isEnabled = true
+                    btn.text = "Instalează"
+                    btn.setOnClickListener { attemptInstall(file) }
+                    attemptInstall(file)
+                }
+            }
+        )
+    }
+
+    private fun attemptInstall(file: File) {
+        if (!UpdateManager.canInstall(this)) {
